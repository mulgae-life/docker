# .env는 각 서버의 런타임 로드본이라 git에도 S3에도 올리지 않는다.
# .env.dev/.env.prd는 환경별 원본(토큰·비밀번호 포함) — git 대신 S3로만 전달하고,
# 배포 후 각 서버에서 `cp .env.prd .env`로 골라 쓴다.
.env
.env.dev
.env.prd

.vllm_serve_*

# vLLM nightly wheel (gemma4_mtp 포함) — 빌드 컨텍스트 사본. 정본은 /models/wheels/.
# 246MB 바이너리라 git 추적 제외 (Dockerfile.llm이 COPY + pip install로 사용).
aws/wheels/

.claude/scratch

.archive/

__pycache__/

logs/
samples/

# vLLM launcher runtime 파일 (port 자동 회피 결과 — PID 종속 동적 상태)
.runtime/
